# 실사 이미지 생성 (OpenAI gpt-image-1) — 설정 시 시뮬레이터에서 자동 전환
# 키 발급: https://platform.openai.com/api-keys → .env.local에 복사 후 dev 서버 재시작
OPENAI_API_KEY=

# 실사 모드 잡당 생성 컷 수 상한 (기본 4 — 실비 보호, 최대 10)
BABYSTUDIO_REAL_CUTS=4

# 결제 웹훅 서명 시크릿 (기본: demo-webhook-secret)
PAYMENT_WEBHOOK_SECRET=

# SQLite 경로 오버라이드 (기본: data/babystudio.db)
# BABYSTUDIO_DB=
